EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon-or-publishable-key>
# Region used to invoke sync-balances (Binance blocks US IPs with HTTP 451)
EXPO_PUBLIC_FUNCTIONS_REGION=eu-central-1
# Public Supabase Storage bucket with the token icons (supported_assets.image_url may be a file name in it)
EXPO_PUBLIC_ASSET_IMAGES_BUCKET=asset-icons
