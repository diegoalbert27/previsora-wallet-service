{
  "expo": {
    "name": "Previsora Wallet",
    "slug": "previsora-wallet-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font"
    ],
    "scheme": "previsora",
    "experiments": {
      "typedRoutes": true
    }
  }
}
