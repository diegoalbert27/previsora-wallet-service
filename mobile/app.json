{
  "expo": {
    "name": "Previsora Wallet",
    "slug": "previsora-wallet-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.previsorawallet.app",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-status-bar",
      "expo-image",
      "expo-web-browser"
    ],
    "scheme": "previsora",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "edd7286a-ca63-426e-ab68-5c6bbe6dcd95"
      }
    },
    "owner": "diogoven"
  }
}
